{
  "name": "stock-mcp-chatbot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",
  "forwardPorts": [
    7860
  ],
  "portsAttributes": {
    "7860": {
      "label": "stock-mcp-chatbot",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m pip install --user -r requirements.txt",
  "postStartCommand": "bash -lc 'nohup flock -n /tmp/stock-mcp-chatbot.lock python -u app.py >> /tmp/stock-mcp-chatbot.log 2>&1 < /dev/null &'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
